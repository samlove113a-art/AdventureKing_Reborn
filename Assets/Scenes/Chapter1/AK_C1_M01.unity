  m_Name: 
  m_EditorClassIdentifier: AdventureKing.Gameplay::AdventureKing.Gameplay.NpcTalkSpot
  actor: {fileID: 444650160}
  eventKey: talk:mushroom_elder
  npcName: "Tr\u01B0\u1EDFng L\xE0ng N\u1EA5m"
  prompt: {fileID: 1756631299}
  bubble: {fileID: 1420451238}
  lines:
  - "Ch\xE0o m\u1EEBng {name} t\u1EDBi L\xE0ng N\u1EA5m! Qu\u1EA3ng tr\u01B0\u1EDDng n\xE0y l\xE0 v\xF9ng an to\xE0n, c\u1EE9 ngh\u1EC9 ng\u01A1i tho\u1EA3i m\xE1i."
  - "L\u0169 N\u1EA5m Non ngo\xE0i c\u1ED5ng \u0111\xF4ng ngh\u1ECBch l\u1EAFm. H\u1EA1 gi\xFAp ta v\xE0i \u0111\u1EE9a, r\u1ED3i quay l\u1EA1i \u0111\xE2y nh\xE9."
  - "Xa h\u01A1n v\u1EC1 ph\xEDa \u0111\xF4ng l\xE0 c\u1EA3 V\u01B0\u01A1ng Qu\u1ED1c N\u1EA5m... v\xE0 Vua N\u1EA5m Qu\u1EF7 \u0111ang th\u1EE9c gi\u1EA5c."
  range: 2.4
