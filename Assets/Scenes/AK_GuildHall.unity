  actor: {fileID: 1021242053}
  eventKey: 
  npcName: "\u0110\u1ED9i Tr\u01B0\u1EDFng Li\xEAn Minh"
  prompt: {fileID: 2000480078}
  bubble: {fileID: 823943637}
  lines:
  - "Ch\xE0o {name}! Ta l\xE0 \u0110\u1ED9i Tr\u01B0\u1EDFng Li\xEAn Minh. Qu\u1EA7y n\xE0y nh\u1EADn \u0111\u01A1n gia nh\u1EADp v\xE0 nhi\u1EC7m v\u1EE5 bang."
  - "H\u1EC7 th\u1ED1ng bang h\u1ED9i \u0111ang \u0111\u01B0\u1EE3c d\u1EF1ng: l\u1EADp bang, c\u1ED1ng hi\u1EBFn v\xE0 nhi\u1EC7m v\u1EE5 bang s\u1EBD m\u1EDF t\u1EA1i \u0111\xE2y."
  - "B\u1EA3ng x\u1EBFp h\u1EA1ng bang \u1EDF b\xEAn ph\u1EA3i. Ngai Bang Ch\u1EE7 d\xE0nh cho ng\u01B0\u1EDDi d\u1EABn d\u1EAFt c\u1EA3 li\xEAn minh!"
  range: 2.4
