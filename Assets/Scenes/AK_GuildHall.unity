  m_Script: {fileID: 11500000, guid: d6a3256cd8c8f2942ad198527942d9ea, type: 3}
  m_Name: 
  m_EditorClassIdentifier: AdventureKing.Gameplay::AdventureKing.Gameplay.NpcTalkSpot
  actor: {fileID: 97607560}
  eventKey: 
  npcName: "\u0110\u1ED9i Tr\u01B0\u1EDFng Li\xEAn Minh"
  prompt: {fileID: 59875609}
  bubble: {fileID: 559208805}
  lines:
  - "Ch\xE0o {name}! Ta l\xE0 \u0110\u1ED9i Tr\u01B0\u1EDFng Li\xEAn Minh. L\u1EADp bang, xin v\xE0o bang hay qu\u1EA3n l\xFD bang \u0111\u1EC1u \u1EDF qu\u1EA7y n\xE0y."
  - "B\u1EA3ng x\u1EBFp h\u1EA1ng bang \u1EDF b\xEAn ph\u1EA3i. Ngai Bang Ch\u1EE7 d\xE0nh cho ng\u01B0\u1EDDi d\u1EABn d\u1EAFt c\u1EA3 li\xEAn minh!"
  - "Trong s\u1EA3nh n\xE0y, c\xE1c th\xE0nh vi\xEAn c\xF9ng bang th\u1EA5y nhau \u1EDF khu sinh ho\u1EA1t ri\xEAng c\u1EE7a bang."
  range: 2.4
